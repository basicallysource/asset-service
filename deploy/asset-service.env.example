# Copy to /etc/asset-service/asset-service.env, fill in, chmod 600.
# This file holds a storage credential. It is owned by the operator; a release
# never reads or rewrites it.

# Where the catalog and the upload spool live inside the container. These match
# the volume mounted by docker-compose.yml.
ASSET_DB_PATH=/data/catalog.db
ASSET_SPOOL_DIR=/data/spool

# Where readers fetch public objects: a CDN or other edge in front of the same
# bucket. Bytes are served from here, never through this service.
ASSET_PUBLIC_BASE_URL=https://assets.example.com

# S3-compatible storage. The credential should be scoped to this bucket alone.
ASSET_S3_ENDPOINT=https://nyc3.example.com
ASSET_S3_REGION=nyc3
ASSET_S3_BUCKET=my-assets
ASSET_S3_ACCESS_KEY=
ASSET_S3_SECRET_KEY=
# Address the bucket as a path segment rather than a subdomain. Needed by some
# providers and by most local test servers.
#ASSET_S3_PATH_STYLE=false

# Optional, with their defaults.
#ASSET_ADDR=:8080
#ASSET_LOG_LEVEL=info
#ASSET_MAX_UPLOAD_BYTES=256MiB
#ASSET_UPLOAD_TIMEOUT=30m
#ASSET_SIGNED_URL_TTL=15m
